{
  "name": "@zixiao-labs/ui-kits-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Zixiao Laboratories UI Kits — multi-style React component library workspace.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @zixiao-labs/ui-kits-demo dev",
    "build": "pnpm -r build",
    "preview": "pnpm --filter @zixiao-labs/ui-kits-demo preview",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck",
    "test": "lightning run",
    "test:watch": "lightning watch",
    "test:e2e": "lightning run --config lightning.e2e.config.ts"
  },
  "devDependencies": {
    "@lightning-js/lightning": "^3.1.2",
    "@types/node": "^22.0.0",
    "oxfmt": "^0.76.0",
    "oxlint": "1.91.0",
    "playwright": "1.64.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.18.0"
}
