{
  "name": "@zixiao-labs/ui-kits-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Zixiao Laboratories UI Kits — multi-style React and SolidJS component library workspace.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @zixiao-labs/ui-kits-demo dev",
    "dev:solid": "pnpm --filter @zixiao-labs/ui-kits-solid-demo dev",
    "build": "pnpm -r build",
    "build:lib": "pnpm --filter @zixiao-labs/ui-kits-react build",
    "build:solid": "pnpm --filter @zixiao-labs/ui-kits-solid-demo... build",
    "preview:solid": "pnpm --filter @zixiao-labs/ui-kits-solid-demo preview",
    "preview": "pnpm --filter @zixiao-labs/ui-kits-demo preview",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck",
    "test": "lightning run",
    "test:watch": "lightning watch",
    "test:package": "lightning run --config lightning.package.config.ts",
    "test:e2e": "lightning run --config lightning.e2e.config.ts",
    "release:check": "node scripts/check-release.ts",
    "release:pack": "pnpm release:check && pnpm --filter @zixiao-labs/ui-kits-react pack --out test-results/ui-kits-react.tgz"
  },
  "devDependencies": {
    "@lightning-js/lightning": "^3.1.2",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "oxfmt": "^0.76.0",
    "oxlint": "1.91.0",
    "playwright": "1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.18.0"
}
