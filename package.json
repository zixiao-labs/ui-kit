{
  "name": "@zixiao-labs/ui-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @zixiao-labs/demo dev",
    "build": "pnpm -r build",
    "preview": "pnpm --filter @zixiao-labs/demo preview",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck",
    "test:e2e": "pnpm build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "oxfmt": "^0.76.0",
    "oxlint": "1.91.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.16.1"
}
