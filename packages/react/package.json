{
  "name": "@zixiao-labs/ui-kits-react",
  "version": "0.0.0",
  "private": true,
  "description": "Zixiao Laboratories UI Kits — shared React components with scoped, interchangeable styles.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./base.css": "./src/base.css",
    "./themes/*.css": "./src/themes/*.css"
  },
  "scripts": {
    "styles:generate": "node scripts/generate-styles.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
