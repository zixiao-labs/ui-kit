{
  "name": "@zixiao-labs/ui-kits-react",
  "version": "0.0.0",
  "private": true,
  "description": "Zixiao Laboratories UI Kits — shared React components with scoped, interchangeable styles.",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme.ts",
    "./styles.css": "./src/styles.css",
    "./base.css": "./src/base.css",
    "./themes/*.css": "./src/themes/*.css"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./theme": {
        "types": "./dist/theme.d.ts",
        "import": "./dist/theme.js",
        "default": "./dist/theme.js"
      },
      "./styles.css": "./dist/styles.css",
      "./base.css": "./dist/base.css",
      "./themes/*.css": "./dist/themes/*.css"
    }
  },
  "scripts": {
    "build": "pnpm styles:generate && tsdown",
    "prepack": "pnpm build",
    "styles:generate": "node scripts/generate-styles.mjs",
    "shaders:generate": "node scripts/generate-shadow.mjs && oxfmt --write src/shadow.shader.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gravity-ui/icons": "^2.23.1",
    "@internationalized/date": "^3.12.4",
    "@material/material-color-utilities": "0.3.0",
    "react-aria": "3.53.1",
    "react-aria-components": "^1.22.1",
    "vgpu": "^0.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vgpu/wgsl": "0.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "0.23.7",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
