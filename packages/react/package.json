{
  "name": "@zixiao-labs/ui-kits-react",
  "version": "0.2.0",
  "description": "Zixiao Laboratories UI Kits — shared React components with scoped, interchangeable styles.",
  "keywords": [
    "components",
    "design-system",
    "react",
    "react-aria",
    "themes",
    "ui"
  ],
  "homepage": "https://github.com/zixiao-labs/ui-kit#readme",
  "bugs": {
    "url": "https://github.com/zixiao-labs/ui-kit/issues"
  },
  "license": "MIT",
  "author": "Zixiao Laboratories",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zixiao-labs/ui-kit.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "docs",
    "skills"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme.ts",
    "./patterns": "./src/optional/patterns.tsx",
    "./patterns.css": "./src/optional/patterns.css",
    "./liquid-glass": "./src/optional/liquid-glass.tsx",
    "./liquid-glass.css": "./src/optional/liquid-glass.css",
    "./styles.css": "./src/styles.css",
    "./base.css": "./src/base.css",
    "./tailwind.css": "./src/optional/tailwind.css",
    "./css/*.css": "./src/*.css",
    "./themes/*.css": "./src/themes/*.css"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./theme": {
        "types": "./dist/theme.d.ts",
        "import": "./dist/theme.js",
        "default": "./dist/theme.js"
      },
      "./patterns": {
        "types": "./dist/patterns.d.ts",
        "import": "./dist/patterns.js",
        "default": "./dist/patterns.js"
      },
      "./patterns.css": "./dist/patterns.css",
      "./liquid-glass": {
        "types": "./dist/liquid-glass.d.ts",
        "import": "./dist/liquid-glass.js",
        "default": "./dist/liquid-glass.js"
      },
      "./liquid-glass.css": "./dist/liquid-glass.css",
      "./styles.css": "./dist/styles.css",
      "./base.css": "./dist/base.css",
      "./tailwind.css": "./dist/tailwind.css",
      "./css/*.css": "./dist/css/*.css",
      "./themes/*.css": "./dist/themes/*.css"
    },
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pnpm styles:generate && tsdown",
    "prepack": "pnpm build",
    "styles:generate": "node scripts/generate-styles.mjs",
    "shaders:generate": "node scripts/generate-shadow.mjs && oxfmt --write src/shadow.shader.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gravity-ui/icons": "^2.23.1",
    "@internationalized/date": "^3.12.4",
    "@material/material-color-utilities": "0.3.0",
    "react-aria": "3.53.1",
    "react-aria-components": "^1.22.1",
    "vgpu": "^0.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vgpu/wgsl": "0.6.0",
    "liquid-glass-react": "1.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "0.23.7",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "liquid-glass-react": "^1.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "liquid-glass-react": {
      "optional": true
    }
  }
}
